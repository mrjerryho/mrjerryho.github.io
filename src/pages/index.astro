---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectRow from '../components/ProjectRow.astro';
import { site, experience } from '../data/site';

const all = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = all.filter((p) => p.data.featured);
const shownExperience = experience.filter((e) => import.meta.env.DEV || !e.draft);
const principles = [
  { title: 'I own the design', body: 'Architecture, data models and the decisions that are hard to undo stay with me.' },
  { title: 'AI makes me faster', body: 'I use AI coding tools heavily, inside a workflow I set up, and I review every change that ships.' },
  { title: 'Proof over claims', body: 'Nothing is done until a test or a real run proves it. A port has to match the original’s outputs, not roughly.' },
  { title: 'Guardrails in code', body: 'Safety rules such as read-only audits and no destructive operations are enforced by tooling, not memory.' },
  { title: 'A second brain that compounds', body: 'Decisions, research and lessons go into an Obsidian knowledge base, so each project starts from what the last one taught me.' },
];
---
<Base>
  <section class="wrap pt-12 pb-16 sm:pt-20">
    <div class="grid gap-10 sm:grid-cols-[1fr_auto] items-end">
      <div>
        <p class="eyebrow mb-5">{site.title} · {site.location}</p>
        <h1 class="text-4xl sm:text-6xl font-semibold leading-[1.05] max-w-[17ch]">
          A decade of <span class="whitespace-nowrap">full-stack</span> engineering, made faster with AI.
        </h1>
        <p class="text-lg muted mt-6 max-w-[58ch]">
          Coding since 2012 and shipping software professionally for almost ten years, across streaming media,
          e-commerce and real estate tech. I design the systems and own the decisions, and AI tooling lets me build,
          test and iterate faster. Outside work I build trading tools, a fitness game and focus apps.
        </p>
        <div class="flex flex-wrap gap-x-6 gap-y-2 mt-8 text-[15px]">
          <a class="link" href="/projects/">See the work</a>
          <a class="link" href={`mailto:${site.email}`}>Email me</a>
          <a class="link" href={site.linkedin}>LinkedIn</a>
        </div>
      </div>
      <img src="/img/jerry.jpg" alt="Jerry Ho" width="180" height="180"
           class="hidden sm:block w-[180px] h-[180px] rounded-full object-cover object-top border border-[var(--line)]" />
    </div>
  </section>

  <section class="wrap" aria-labelledby="work">
    <div class="flex items-baseline justify-between mb-2">
      <h2 id="work" class="eyebrow">Selected work</h2>
      <a href="/projects/" class="text-sm muted no-underline hover:text-[var(--ink)]">All projects →</a>
    </div>
    {featured.map((p, i) => <ProjectRow project={p} index={i + 1} />)}
  </section>

  <section class="wrap mt-16" aria-labelledby="experience">
    <h2 id="experience" class="eyebrow mb-8">Professional experience</h2>
    <div class="grid gap-x-12 gap-y-10 md:grid-cols-2">
      {shownExperience.map((e) => (
        <div class:list={['border-t border-[var(--line)] pt-6', { 'opacity-50': e.draft }]}>
          <h3 class="text-xl font-semibold">{e.area}{e.draft && <span class="mono text-xs muted ml-2">draft, hidden in production</span>}</h3>
          <ul class="mt-3 space-y-2">
            {e.points.map((pt) => <li class="muted">{pt}</li>)}
          </ul>
          {e.stack.length > 0 && <ul class="flex flex-wrap gap-2 mt-4">{e.stack.map((s) => <li class="chip">{s}</li>)}</ul>}
        </div>
      ))}
    </div>
  </section>

  <section class="wrap mt-24" aria-labelledby="how-i-work">
    <div class="border-t border-[var(--line)] pt-10 grid gap-10 md:grid-cols-[1fr_1.6fr]">
      <h2 id="how-i-work" class="text-3xl font-semibold leading-tight max-w-[14ch]">How I work</h2>
      <dl class="grid gap-7 sm:grid-cols-2">
        {principles.map((p) => (
          <div>
            <dt class="font-semibold">{p.title}</dt>
            <dd class="muted mt-1">{p.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>
</Base>
