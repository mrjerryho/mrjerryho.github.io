---
interface Box { name: string; detail: string; highlight?: boolean }
interface Props {
  columns: { title: string; boxes: Box[] }[];
  links: string[];
  caption?: string;
}
const { columns, links, caption } = Astro.props;
---
<figure class="arch">
  <div class="arch-row">
    {columns.map((col, i) => (
      <>
        <div class="arch-col">
          <div class="eyebrow mb-3">{col.title}</div>
          {col.boxes.map((b) => (
            <div class:list={['arch-box', { hi: b.highlight }]}>
              <div class="font-medium text-[14px] leading-snug">{b.name}</div>
              <div class="muted text-[13px] leading-snug mt-1">{b.detail}</div>
            </div>
          ))}
        </div>
        {i < columns.length - 1 && (
          <div class="arch-link" aria-hidden="true">
            <span class="arch-arrow"></span>
            <span class="mono text-[11px] muted text-center leading-tight">{links[i] ?? ''}</span>
          </div>
        )}
      </>
    ))}
  </div>
  {caption && <figcaption class="muted text-sm mt-4 max-w-[68ch]">{caption}</figcaption>}
</figure>

<style>
  .arch { margin: 0; }
  .arch-row { display: flex; align-items: stretch; gap: 0; }
  .arch-col { flex: 1 1 0; min-width: 0; border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: var(--panel); }
  .arch-box { border: 1px solid var(--line); background: var(--bg); border-radius: 8px; padding: 10px 12px; }
  .arch-box + .arch-box { margin-top: 8px; }
  .arch-box.hi { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
  .arch-link { flex: 0 0 92px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; padding: 0 8px; }
  .arch-arrow { display: block; width: 100%; height: 1px; background: var(--muted); position: relative; }
  .arch-arrow::after { content: ""; position: absolute; right: -1px; top: -4px; border: 4.5px solid transparent; border-left: 7px solid var(--muted); }
  @media (max-width: 760px) {
    .arch-row { flex-direction: column; }
    .arch-link { flex: 0 0 auto; flex-direction: row; padding: 10px 0; }
    .arch-arrow { width: 1px; height: 28px; }
    .arch-arrow::after { right: auto; left: -4px; top: auto; bottom: -1px; border: 4.5px solid transparent; border-top: 7px solid var(--muted); }
  }
</style>
