---
import type { CollectionEntry } from 'astro:content';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project, index } = Astro.props;
const d = project.data;
const href = `/projects/${project.id}/`;
---
<article class:list={['row', { 'has-cover': !!d.cover }]}>
  <div class="row-text">
    <div class="flex items-center gap-3 mb-3">
      <span class="mono text-xs muted">{String(index).padStart(2, '0')}</span>
      <span class="status">{d.status}</span>
      {d.workingName && <span class="mono text-xs muted">working name</span>}
    </div>
    <h3 class="text-2xl font-semibold"><a href={href} class="no-underline hover:text-[var(--accent-ink)]">{d.title}</a></h3>
    <p class="muted mt-1">{d.subtitle}</p>
    <p class="mt-4 max-w-[52ch]">{d.summary}</p>
    <ul class="flex flex-wrap gap-2 mt-5" aria-label="Stack">
      {d.stack.slice(0, 6).map((s) => <li class="chip">{s}</li>)}
    </ul>
    <a href={href} class="link inline-block mt-6 text-[15px]">Read the write-up →</a>
  </div>
  {d.cover && (
    <a href={href} class="row-cover" tabindex="-1" aria-hidden="true">
      <img src={d.cover} alt="" loading="lazy" decoding="async" />
    </a>
  )}
</article>

<style>
  .row { display: grid; grid-template-columns: 1fr; gap: 32px; padding: 48px 0; border-top: 1px solid var(--line); }
  .row.has-cover { grid-template-columns: 1.15fr 1fr; align-items: center; }
  .row-cover { display: flex; justify-content: center; align-items: center; background: var(--panel); border-radius: 16px; padding: 28px; height: 420px; }
  .row-cover img { max-height: 100%; width: auto; max-width: 100%; object-fit: contain; border-radius: 12px; box-shadow: 0 12px 40px -18px rgb(0 0 0 / .35); transition: transform .3s ease; }
  .row-cover:hover img { transform: translateY(-3px); }
  @media (max-width: 820px) { .row.has-cover { grid-template-columns: 1fr; } .row-cover { height: 340px; } }
</style>
