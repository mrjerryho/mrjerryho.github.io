---
// A playful "bullet train" carrying media files between two stations. Decorative only (aria-hidden).
const files = ['.mov', '.wav', '.xml', '.mxf'];
---
<svg class="train-scene" viewBox="0 0 880 170" role="img" aria-label="Animation: a train carrying media files from studios to partners">
  <defs>
    <linearGradient id="tr-body" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" class="s-hi" />
      <stop offset="1" class="s-lo" />
    </linearGradient>
  </defs>

  <!-- speed lines in the background -->
  <g class="streaks">
    <rect x="0" y="62" width="110" height="2" rx="1" />
    <rect x="0" y="76" width="70" height="2" rx="1" style="--sd:.35s" />
    <rect x="0" y="90" width="90" height="2" rx="1" style="--sd:.7s" />
  </g>

  <!-- elevated beam + pylons -->
  <rect class="beam" x="0" y="118" width="880" height="9" rx="4.5" />
  <g class="pylons">
    {Array.from({ length: 11 }, (_, i) => <rect x={40 + i * 80} y="127" width="10" height="43" rx="2" />)}
  </g>

  <!-- the train -->
  <g class="train">
    <path class="body" d="M0 66 Q0 52 14 52 L290 52 Q356 52 372 86 Q376 98 362 104 L14 104 Q0 104 0 90 Z" />
    <rect class="stripe" x="0" y="92" width="366" height="5" />
    <path class="nose" d="M318 58 Q350 60 362 84 L330 84 Q322 70 318 58 Z" />
    {files.map((f, i) => (
      <g transform={`translate(${22 + i * 72} 60)`}>
        <rect class="window" width="58" height="26" rx="6" />
        <path class="doc" d="M8 5 h10 l5 5 v12 h-15 z" />
        <text class="ext" x="27" y="18">{f}</text>
      </g>
    ))}
    <rect class="skid" x="20" y="104" width="330" height="10" rx="5" />
  </g>
  <!-- stations, drawn last so the train slides in and out of them -->
  <g class="station">
    <rect x="12" y="44" width="96" height="70" rx="8" />
    <text x="60" y="84" text-anchor="middle">Studios</text>
  </g>
  <g class="station">
    <rect x="772" y="44" width="96" height="70" rx="8" />
    <text x="820" y="84" text-anchor="middle">Partners</text>
  </g>

</svg>

<style>
  .train-scene { display: block; width: 100%; height: auto; }
  .s-hi { stop-color: color-mix(in oklch, var(--accent) 55%, var(--bg)); }
  .s-lo { stop-color: var(--accent); }
  .station rect { fill: var(--panel); stroke: var(--line); stroke-width: 1.5; }
  .station text { fill: var(--muted); font: 600 13px var(--font-mono), ui-monospace, monospace; }
  .beam { fill: color-mix(in oklch, var(--ink) 75%, var(--bg)); }
  .pylons rect { fill: color-mix(in oklch, var(--ink) 25%, var(--bg)); }
  .streaks rect { fill: var(--muted); opacity: 0; }
  .streaks rect { opacity: 0; }
  .train .body { fill: url(#tr-body); }
  .train .stripe { fill: var(--bg); opacity: .55; }
  .train .nose { fill: var(--bg); opacity: .35; }
  .train .window { fill: var(--bg); }
  .train .doc { fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linejoin: round; }
  .train .ext { fill: var(--ink); font: 600 10px var(--font-mono), ui-monospace, monospace; }
  .train .skid { fill: color-mix(in oklch, var(--ink) 60%, var(--bg)); }
  .train { transform: translateX(255px); }

  @media (prefers-reduced-motion: no-preference) {
    .train { animation: zoom 3.4s linear infinite; }
    .streaks rect { animation: streak 1.2s linear infinite; animation-delay: var(--sd, 0s); }
  }
  /* Glide in from the studio, pause mid-line, then rocket out to the partner station. */
  @keyframes zoom {
    0%   { transform: translateX(-380px); animation-timing-function: cubic-bezier(.2, .7, .3, 1); }
    38%  { transform: translateX(255px); }
    55%  { transform: translateX(255px); animation-timing-function: cubic-bezier(.7, 0, .9, .4); }
    88%  { transform: translateX(900px); }
    100% { transform: translateX(900px); }
  }
  @keyframes streak {
    0%   { transform: translateX(-160px); opacity: 0; }
    20%  { opacity: .35; }
    100% { transform: translateX(900px); opacity: 0; }
  }
</style>
